          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="生成唯一用户测试数据" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters" />
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
def seed = System.currentTimeMillis().toString() + '_' + ctx.getThreadNum() + '_' + vars.getIteration()
def number = Math.abs(seed.hashCode())
vars.put('perf_user_name', 'perf_user_' + seed)
vars.put('perf_user_nick', '性能用户_' + seed)
vars.put('perf_user_updated_nick', '性能用户已修改_' + seed)
vars.put('perf_user_email', 'perf_user_' + seed + '@example.com')
vars.put('perf_user_phone', '139' + String.format('%08d', number % 100000000))
</stringProp>
          </JSR223PreProcessor>
