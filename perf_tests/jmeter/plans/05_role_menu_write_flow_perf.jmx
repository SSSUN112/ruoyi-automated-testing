def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def target = vars.get('perf_menu_name')
def containsTitle
containsTitle = { node -&gt;
    if (node instanceof Map) {
        def meta = node.meta ?: [:]
        if (meta.title == target) { return true }
        def children = node.children ?: []
        return children.any { containsTitle(it) }
    }
    return false
}
def routes = json.data ?: []
if (routes.any { containsTitle(it) }) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('分配前普通用户不应看到菜单：' + target)
}
</stringProp>
