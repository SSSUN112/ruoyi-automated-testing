          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取验证码 uuid" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">captcha_uuid;captcha_enabled</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.uuid;$.captchaEnabled</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;true</stringProp>
          </JSONPostProcessor>
          <hashTree />
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="从 Redis 读取验证码答案" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters" />
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
if (vars.get('captcha_enabled') == 'false') {
    vars.put('captcha_code', '')
    return
}

def uuid = vars.get('captcha_uuid')
if (!uuid || uuid == 'NOT_FOUND') {
    throw new AssertionError('验证码 uuid 提取失败')
}

def socket = new Socket(vars.get('redis_host'), vars.get('redis_port') as int)
socket.soTimeout = 5000
def input = socket.getInputStream()
def output = socket.getOutputStream()

def readLine = {
    def buffer = new ByteArrayOutputStream()
    int previous = -1
    int current
    while ((current = input.read()) != -1) {
        if (previous == 13 &amp;&amp; current == 10) {
            def bytes = buffer.toByteArray()
            return new String(bytes, 0, bytes.length - 1, 'UTF-8')
        }
        buffer.write(current)
        previous = current
    }
    throw new EOFException('Redis 响应读取失败')
}

def readFixedBytes = { int length -&gt;
    byte[] bytes = new byte[length]
    int offset = 0
    while (offset &lt; length) {
        int count = input.read(bytes, offset, length - offset)
        if (count &lt; 0) {
            throw new EOFException('Redis bulk string 读取失败')
        }
        offset += count
    }
    input.read()
    input.read()
    return bytes
}

def readResp
readResp = {
    int prefix = input.read()
    if (prefix &lt; 0) {
        throw new EOFException('Redis 无响应')
    }

    switch ((char) prefix) {
        case '+':
            return readLine()
        case '-':
            throw new RuntimeException('Redis 错误：' + readLine())
        case ':':
            return readLine()
        case '$':
            int length = readLine() as int
            if (length == -1) {
                return null
            }
            return new String(readFixedBytes(length), 'UTF-8')
        case '*':
            int count = readLine() as int
            def values = []
            count.times { values &lt;&lt; readResp() }
            return values
        default:
            throw new RuntimeException('未知 Redis 响应类型：' + ((char) prefix))
    }
}

def sendCommand = { List&lt;String&gt; parts -&gt;
    output.write(("*${parts.size()}\r\n").getBytes('UTF-8'))
    parts.each { part -&gt;
        byte[] bytes = part.getBytes('UTF-8')
        output.write(('$' + bytes.length + '\r\n').getBytes('UTF-8'))
        output.write(bytes)
        output.write("\r\n".getBytes('UTF-8'))
    }
    output.flush()
    return readResp()
}

try {
    def password = vars.get('redis_password')
    if (password) {
        sendCommand(['AUTH', password])
    }

    def db = vars.get('redis_db')
    if (db) {
        sendCommand(['SELECT', db])
    }

    def redisKey = 'captcha_codes:' + uuid
    def code = sendCommand(['GET', redisKey])
    if (!code) {
        throw new AssertionError('Redis 中未找到验证码：' + redisKey)
    }

    vars.put('captcha_code', code.toString())
} finally {
    socket.close()
}
</stringProp>
          </JSR223PostProcessor>
