        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="生成唯一权限流程测试数据" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters" />
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
def seed = (System.currentTimeMillis() % 100000000).toString() + ctx.getThreadNum() + vars.getIteration()
def number = Math.abs(seed.hashCode())
vars.put('perf_menu_name', '权限菜单_' + seed)
vars.put('perf_menu_path', 'perm-' + seed)
vars.put('perf_menu_perm', 'system:perf:permission:' + seed)
vars.put('perf_role_name', '权限角色_' + seed)
vars.put('perf_role_key', 'prole_' + seed)
vars.put('perf_user_name', 'pperm_' + seed)
vars.put('perf_user_nick', '权限用户_' + seed)
vars.put('perf_user_email', 'pperm_' + seed + '@example.com')
vars.put('perf_user_phone', '139' + String.format('%08d', number % 100000000))
</stringProp>
          </JSR223PreProcessor>
