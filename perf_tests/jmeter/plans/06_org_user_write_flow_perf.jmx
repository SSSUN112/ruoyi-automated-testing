          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言部门岗位绑定正确" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters" />
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
if (json.data.userName != vars.get('perf_user_name')) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('用户详情 userName 不匹配')
    return
}
if (json.data.deptId.toString() != vars.get('dept_id')) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('用户详情 deptId 不匹配')
    return
}
def postIds = (json.postIds ?: []).collect { it.toString() }
if (!postIds.contains(vars.get('post_id'))) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('用户详情 postIds 不包含新岗位')
}
</stringProp>
