          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="生成唯一组织流程测试数据" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters" />
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
def seed = (System.currentTimeMillis() % 100000000).toString() + ctx.getThreadNum() + vars.getIteration()
def number = Math.abs(seed.hashCode())
vars.put('perf_dept_name', '性能部门_' + seed)
vars.put('perf_post_code', 'perf_post_' + seed)
vars.put('perf_post_name', '性能岗位_' + seed)
vars.put('perf_user_name', 'porg_' + seed)
vars.put('perf_user_nick', '组织用户_' + seed)
vars.put('perf_user_email', 'porg_' + seed + '@example.com')
vars.put('perf_user_phone', '139' + String.format('%08d', number % 100000000))
</stringProp>
          </JSR223PreProcessor>
